{
  "name": "kira-version-vscode",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run check:types && bun run check:tokens && bun run check:settings && bun run check:lane-palette",
    "check:types": "tsc --build && bun run --filter '@kira-version/ui' check:vue",
    "check:types:clean": "tsc --build --force && bun run --filter '@kira-version/ui' check:vue",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check:tokens": "bun run scripts/check-tokens.ts",
    "check:settings": "bun run scripts/gen-settings.ts --check",
    "gen:settings": "bun run scripts/gen-settings.ts",
    "check:lane-palette": "bun run scripts/gen-lane-palette.ts --check",
    "gen:lane-palette": "bun run scripts/gen-lane-palette.ts",
    "build": "bun run scripts/build.ts",
    "test:unit": "bun test packages tests/fixtures tests/unit",
    "test:integration": "bun test tests/integration",
    "test:integration:sharded": "bun run scripts/test-shard.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:e2e": "playwright test",
    "test:e2e:vscode": "bun run scripts/e2e-display.ts test --project=vscode",
    "test:perf": "bun run tests/perf/run.ts && bun run tests/perf/parserThroughput.ts && bun run tests/perf/historyPipeline.ts && bun run tests/perf/streamRoundTrip.ts && bun run tests/perf/graphUi.ts",
    "dev:harness": "bun run --filter '@kira-version/harness' dev"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "@types/node": "26.2.0",
    "@vscode/test-electron": "3.1.0",
    "playwright-core": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
